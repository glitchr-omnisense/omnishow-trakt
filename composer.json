{
    "name": "omnishow/trakt",
    "type": "library",
    "description": "Omnishow's Trakt, under any PHP host: search, a film's or a show's record and its people, a work or an episode by its Trakt, IMDb, TMDB or TheTVDB number, a season's episodes, through Trakt's public API with an application's client id (no user signed in).",
    "keywords": [
        "trakt",
        "film",
        "movie",
        "tv",
        "series",
        "episode",
        "framework-agnostic",
        "omnishow"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnishow-trakt",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnishow": "^1.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnishow\\Trakt\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnishow\\Trakt\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
